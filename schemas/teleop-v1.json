{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BackendState": {
      "enum": [
        "DISCONNECTED",
        "IDLE",
        "MOVING",
        "HOLD",
        "FAULT"
      ],
      "title": "BackendState",
      "type": "string"
    },
    "ConstraintKind": {
      "enum": [
        "workspace_boundary",
        "ik_boundary",
        "joint_boundary",
        "motion_continuity_boundary",
        "self_collision"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "ClientControlMessage": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "enum": [
            "hello",
            "arm_request",
            "disarm",
            "reset_fault",
            "home_request",
            "ping"
          ],
          "title": "Type",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "client_mono_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Mono Ms"
        }
      },
      "required": [
        "v",
        "type",
        "request_id"
      ],
      "title": "ClientControlMessage",
      "type": "object"
    },
    "FaultResetAccepted": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "type": {
          "const": "fault_reset_result",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "accepted": {
          "const": true,
          "type": "boolean"
        },
        "mode": {
          "const": "DISARMED",
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "accepted",
        "mode"
      ],
      "type": "object"
    },
    "FaultResetRejected": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "type": {
          "const": "fault_reset_result",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "accepted": {
          "const": false,
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "no_fault",
            "stop_incomplete",
            "backend_moving",
            "unrecoverable_fault",
            "control_loop_unavailable"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "accepted",
        "reason",
        "message"
      ],
      "type": "object"
    },
    "FaultResetResultMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/FaultResetAccepted"
        },
        {
          "$ref": "#/$defs/FaultResetRejected"
        }
      ]
    },
    "HomeAccepted": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "type": {
          "const": "home_result",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "accepted": {
          "const": true,
          "type": "boolean"
        },
        "mode": {
          "const": "DISARMED",
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "accepted",
        "mode"
      ],
      "type": "object"
    },
    "SetSimulationScaleMessage": {
      "additionalProperties": false,
      "properties": {
        "v": {"const": 1, "type": "integer"},
        "type": {"const": "set_simulation_scale", "type": "string"},
        "request_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "translation_scale": {
          "minimum": 0.5,
          "maximum": 2.0,
          "multipleOf": 0.1,
          "type": "number"
        }
      },
      "required": ["v", "type", "request_id", "translation_scale"],
      "type": "object"
    },
    "SimulationScaleAccepted": {
      "additionalProperties": false,
      "properties": {
        "v": {"const": 1, "type": "integer"},
        "type": {"const": "simulation_scale_result", "type": "string"},
        "request_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "accepted": {"const": true, "type": "boolean"},
        "translation_scale": {
          "minimum": 0.5,
          "maximum": 2.0,
          "multipleOf": 0.1,
          "type": "number"
        }
      },
      "required": ["v", "type", "request_id", "accepted", "translation_scale"],
      "type": "object"
    },
    "SimulationScaleRejected": {
      "additionalProperties": false,
      "properties": {
        "v": {"const": 1, "type": "integer"},
        "type": {"const": "simulation_scale_result", "type": "string"},
        "request_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "accepted": {"const": false, "type": "boolean"},
        "translation_scale": {
          "minimum": 0.5,
          "maximum": 2.0,
          "multipleOf": 0.1,
          "type": "number"
        },
        "reason": {
          "enum": [
            "not_simulation",
            "not_stopped",
            "invalid_scale",
            "automation_active"
          ],
          "type": "string"
        }
      },
      "required": ["v", "type", "request_id", "accepted", "translation_scale", "reason"],
      "type": "object"
    },
    "SimulationScaleResultMessage": {
      "oneOf": [
        {"$ref": "#/$defs/SimulationScaleAccepted"},
        {"$ref": "#/$defs/SimulationScaleRejected"}
      ]
    },
    "HomeRejected": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "type": {
          "const": "home_result",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "maxLength": 64,
          "type": "string"
        },
        "accepted": {
          "const": false,
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "fault_present",
            "grip_pressed",
            "not_stopped",
            "control_loop_unavailable",
            "home_failed"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "accepted",
        "reason",
        "message"
      ],
      "type": "object"
    },
    "HomeResultMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/HomeAccepted"
        },
        {
          "$ref": "#/$defs/HomeRejected"
        }
      ]
    },
    "ControllerState": {
      "additionalProperties": false,
      "properties": {
        "p": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "P",
          "type": "array"
        },
        "q": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Q",
          "type": "array"
        },
        "grip": {
          "title": "Grip",
          "type": "boolean"
        },
        "trigger": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Trigger",
          "type": "number"
        }
      },
      "required": [
        "p",
        "q",
        "grip",
        "trigger"
      ],
      "title": "ControllerState",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "p": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "P",
          "type": "array"
        },
        "q": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Q",
          "type": "array"
        }
      },
      "required": [
        "p",
        "q"
      ],
      "title": "Pose",
      "type": "object"
    },
    "RobotStateMessage": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "robot_state",
          "default": "robot_state",
          "title": "Type",
          "type": "string"
        },
        "server_mono_ns": {
          "minimum": 0,
          "title": "Server Mono Ns",
          "type": "integer"
        },
        "ack_seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ack Seq"
        },
        "mode": {
          "$ref": "#/$defs/TeleopMode"
        },
        "robot_state": {
          "$ref": "#/$defs/BackendState"
        },
        "actual_tcp": {
          "$ref": "#/$defs/Pose"
        },
        "actual_q": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Actual Q",
          "type": "array"
        },
        "gripper": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gripper",
          "type": "number"
        },
        "sample_age_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Age Ms"
        },
        "fault": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fault"
        },
        "constraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConstraintKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint"
        },
        "recovery_phase": {
          "anyOf": [
            {
              "enum": [
                "stopping",
                "homing",
                "stabilizing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery Phase"
        },
        "backend": {
          "anyOf": [
            {
              "enum": [
                "SIMULATOR",
                "LEBAI",
                "LEBAI_FAKE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "real_robot_mode": {
          "anyOf": [
            {
              "enum": [
                "readonly",
                "control"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Real Robot Mode"
        },
        "preflight_ready": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preflight Ready"
        },
        "preflight_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preflight Reason"
        },
        "translation_scale": {
          "anyOf": [
            {
              "minimum": 0.5,
              "maximum": 2.0,
              "type": "number"
            },
            {"type": "null"}
          ],
          "default": null,
          "title": "Translation Scale"
        }
      },
      "required": [
        "server_mono_ns",
        "mode",
        "robot_state",
        "actual_tcp",
        "actual_q",
        "gripper"
      ],
      "title": "RobotStateMessage",
      "type": "object"
    },
    "TeleopMode": {
      "enum": [
        "DISCONNECTED",
        "READY",
        "ARMED",
        "ACTIVE",
        "HOLD",
        "STALE",
        "FAULT",
        "DISARMED"
      ],
      "title": "TeleopMode",
      "type": "string"
    },
    "VRFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "vr_frame",
          "title": "Type",
          "type": "string"
        },
        "session_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "client_mono_ms": {
          "minimum": 0,
          "title": "Client Mono Ms",
          "type": "number"
        },
        "tracking_valid": {
          "title": "Tracking Valid",
          "type": "boolean"
        },
        "visibility": {
          "enum": [
            "visible",
            "visible-blurred",
            "hidden"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/ControllerState"
        }
      },
      "required": [
        "v",
        "type",
        "session_id",
        "seq",
        "client_mono_ms",
        "tracking_valid",
        "visibility",
        "right"
      ],
      "title": "VRFrame",
      "type": "object"
    }
  }
}
